# Supabase configuration is provided at runtime — do NOT commit real keys here.
#
#   Browser (VITE_*):  from .env.local, generated by scripts/dev-base44.sh
#                      from the platform-delivered secrets.
#   Server / workerd:  from .dev.vars, generated by scripts/dev-base44.sh.
#   Production:       set as Cloudflare secrets (wrangler) — never in this file.
#
# The committed .env intentionally leaves these empty so no project-specific
# value leaks into the repo. scripts/dev-base44.sh fills .env.local / .dev.vars
# from /run/base44/app.env (platform secrets) before starting the dev server.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
