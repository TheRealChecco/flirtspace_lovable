# Extends node:22-slim with system CA certificates.
# workerd (Cloudflare runtime used by @cloudflare/vite-plugin) verifies outbound
# TLS against the OS CA store, which is empty on node:*-slim. Node itself bundles
# its own CAs, so only workerd breaks without this. Installing ca-certificates
# fixes all server-side HTTPS calls (Supabase, OpenAI) from the SSR runtime.
FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
